{% schema %}
{
  "name": "Nishorama Hero Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Autoplay Speed",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "NISHOTSAV2"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nishorama Hero Slider",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .cust-gallery-hero {
    position: relative;
    width: 100%;
    height: 100vh; /* Full screen height to match Nishorama */
    overflow: hidden;
    background-color: #000;
  }
  
  .cgh-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0.8s;
  }
  
  .cgh-slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .cgh-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Zoom effect mimicking the animation */
    transform: scale(1.06);
    transition: transform 6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .cgh-slide.active img {
    transform: scale(1);
  }

  .cgh-slide img.mobile {
    display: none;
  }
  
  @media screen and (max-width: 768px) {
    .cgh-slide img.desktop {
      display: none;
    }
    .cgh-slide img.mobile {
      display: block;
    }
  }

  /* Pill Button Overlay */
  .gallery-banner-link {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffffff;
    color: #000000;
    text-decoration: none;
    padding: 12px 35px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    z-index: 3;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .gallery-banner-link:hover {
    transform: translateX(-50%) translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  /* Pagination Dots */
  .cgh-pagination {
    position: absolute;
    bottom: 15px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    gap: 8px;
  }
  
  .cgh-dot {
    width: 6px;
    height: 6px;
    background: rgba(255,255,255,0.5);
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .cgh-dot.active {
    background: #ffffff;
    transform: scale(1.3);
  }
</style>

<div class="cust-gallery-hero" id="cgh-{{ section.id }}" data-autoplay="{{ section.settings.autoplay_speed }}">
  
  <div class="cgh-wrapper">
    {% for block in section.blocks %}
      <div class="cgh-slide {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        
        <!-- Desktop Image -->
        {% if block.settings.image_desktop != blank %}
          {{ block.settings.image_desktop | image_url: width: 2000 | image_tag: class: 'desktop', preload: true }}
        {% else %}
          <div class="desktop" style="width:100%; height:100%; background:#d8c9bd;"></div>
        {% endif %}
        
        <!-- Mobile Image -->
        {% if block.settings.image_mobile != blank %}
          {{ block.settings.image_mobile | image_url: width: 1000 | image_tag: class: 'mobile', preload: true }}
        {% else %}
          <div class="mobile" style="width:100%; height:100%; background:#a89f91;"></div>
        {% endif %}

        <!-- Pill Button -->
        {% if block.settings.btn_text != blank %}
          <a href="{{ block.settings.btn_link | default: '#' }}" class="gallery-banner-link">{{ block.settings.btn_text }}</a>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <!-- Pagination -->
  {% if section.blocks.size > 1 %}
    <div class="cgh-pagination">
      {% for block in section.blocks %}
        <div class="cgh-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('cgh-{{ section.id }}');
    if (!slider) return;

    const slides = slider.querySelectorAll('.cgh-slide');
    const dots = slider.querySelectorAll('.cgh-dot');
    let currentIndex = 0;
    const speed = parseInt(slider.getAttribute('data-autoplay')) * 1000;
    let autoplayInterval;

    function goToSlide(index) {
      slides[currentIndex].classList.remove('active');
      if (dots[currentIndex]) dots[currentIndex].classList.remove('active');
      
      currentIndex = index;
      
      slides[currentIndex].classList.add('active');
      if (dots[currentIndex]) dots[currentIndex].classList.add('active');
    }

    function nextSlide() {
      let next = currentIndex + 1;
      if (next >= slides.length) next = 0;
      goToSlide(next);
    }

    dots.forEach(dot => {
      dot.addEventListener('click', function() {
        clearInterval(autoplayInterval);
        goToSlide(parseInt(this.getAttribute('data-index')));
        startAutoplay();
      });
    });

    function startAutoplay() {
      if (slides.length > 1) {
        autoplayInterval = setInterval(nextSlide, speed);
      }
    }
    
    startAutoplay();
  });
</script>
