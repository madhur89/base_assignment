{% schema %}
{
  "name": "Nisho Campaign Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image (Poster if video is used)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Poster if video is used)"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Direct Video URL (MP4) - Optional"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Nisho Campaign Banner"
    }
  ]
}
{% endschema %}

<style>
  .ncb-section-{{ section.id }} {
    padding: 20px 40px;
    background: #ffffff;
  }

  @media screen and (max-width: 768px) {
    .ncb-section-{{ section.id }} {
      padding: 20px 20px;
    }
  }

  .ncb-container {
    position: relative;
    width: 100%;
    height: 80vh;
    min-height: 500px;
    border-radius: 20px;
    overflow: hidden;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ncb-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ncb-media.mobile {
    display: none;
  }

  @media screen and (max-width: 768px) {
    .ncb-container {
      height: 70vh;
    }
    .ncb-media.desktop { display: none; }
    .ncb-media.mobile { display: block; }
  }

  .ncb-cta-wrapper {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .ncb-btn {
    display: inline-block;
    background: #ffffff;
    color: #121212;
    text-decoration: none;
    padding: 16px 45px;
    border-radius: 40px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.5px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ncb-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
  }
</style>

<div class="ncb-section-{{ section.id }}">
  <div class="ncb-container">
    {%- if section.settings.video_url != blank -%}
      <video class="ncb-media desktop" autoplay muted loop playsinline poster="{{ section.settings.image_desktop | image_url: width: 2000 }}">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
      <video class="ncb-media mobile" autoplay muted loop playsinline poster="{{ section.settings.image_mobile | image_url: width: 1000 }}">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- else -%}
      {%- if section.settings.image_desktop != blank -%}
        {{ section.settings.image_desktop | image_url: width: 2000 | image_tag: class: 'ncb-media desktop', loading: 'lazy' }}
      {%- endif -%}
      {%- if section.settings.image_mobile != blank -%}
        {{ section.settings.image_mobile | image_url: width: 1000 | image_tag: class: 'ncb-media mobile', loading: 'lazy' }}
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <div class="ncb-cta-wrapper">
        <a href="{{ section.settings.btn_link | default: '#' }}" class="ncb-btn">
          {{ section.settings.btn_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
