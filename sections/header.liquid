{% schema %}
{
  "name": "Nishorama Header",
  "class": "section-header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#121212"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 140,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Main Menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "default": true,
      "label": "Enable Sticky Header"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "default": true,
      "label": "Show Announcement text"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "10% OFF Automatically Applied on Orders ₹2,599+"
    }
  ]
}
{% endschema %}

{% if section.settings.show_announcement %}
<div class="mob-notification-text" style="background-color: {{ section.settings.text_color }}; color: {{ section.settings.bg_color }}; text-align: center; padding: 10px 15px; font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase;">
  {{ section.settings.announcement_text }}
</div>
{% endif %}

<header class="home-page header page-width {% if section.settings.enable_sticky %}sticky-header{% endif %}" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="cust-header-main">
    
    <!-- Left: Hamburger + Logo -->
    <div class="cust-header-left">
      <div class="cust-menu-bar" onclick="document.body.classList.toggle('menu-open')">
        <div class="hamburger-menu">
          <span></span>
          <span></span>
        </div>
        <p class="cust-menu-text">Menu</p>
      </div>
      
      <div class="cust-header-logo">
        <a href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: 
              class: 'header__heading-logo',
              width: section.settings.logo_width,
              alt: section.settings.logo.alt | default: shop.name
            }}
          {%- else -%}
            <span class="h2" style="font-weight: 800; font-size: 24px; text-transform: uppercase; letter-spacing: 2px;">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>

    <!-- Middle: Navigation Links -->
    <div class="cust-header-middle desktop-only">
      <ul class="nav-links">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <!-- Right: Action Icons -->
    <div class="cust-header-right">
      <a href="{{ routes.search_url }}" class="icon-link">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="icon-link">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-link cart-link">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span class="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
    
  </div>
</header>

<!-- Mobile/Drawer Menu overlay -->
<div class="mobile-drawer-overlay" onclick="document.body.classList.remove('menu-open')"></div>
<div class="mobile-drawer" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="drawer-header">
    <button class="drawer-close" onclick="document.body.classList.remove('menu-open')" style="color: inherit;">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <ul class="drawer-menu">
    {%- for link in section.settings.menu.links -%}
      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
    {%- endfor -%}
  </ul>
</div>

<style>
/* CSS Variables & Defaults */
:root {
  --header-height: 80px;
}
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 900;
  border-bottom: 1px solid rgba(0,0,0,0.05);
  box-shadow: 0 4px 20px rgba(0,0,0,0.03);
}

/* Base Layout */
.home-page.header {
  width: 100%;
  display: block;
  transition: background-color 0.3s ease;
}
.cust-header-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: var(--header-height);
  padding: 0 40px;
  max-width: 1600px;
  margin: 0 auto;
}

/* Left Section: Menu & Logo */
.cust-header-left {
  display: flex;
  align-items: center;
  gap: 30px;
  flex: 1;
}
.cust-menu-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  padding: 10px 0;
  transition: opacity 0.2s ease;
}
.cust-menu-bar:hover {
  opacity: 0.7;
}
.hamburger-menu {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.hamburger-menu span {
  display: block;
  width: 26px;
  height: 1.5px;
  background-color: currentColor;
  transition: all 0.3s ease;
}
.cust-menu-text {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-weight: 600;
  margin: 0;
}

.cust-header-logo a {
  text-decoration: none;
  color: inherit;
}

/* Middle Section: Links */
.cust-header-middle {
  flex: 2;
  display: flex;
  justify-content: center;
}
.nav-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 36px;
}
.nav-links a {
  text-decoration: none;
  color: inherit;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  font-weight: 600;
  position: relative;
  padding-bottom: 6px;
}
.nav-links a::after {
  content: '';
  position: absolute;
  width: 0;
  height: 1.5px;
  bottom: 0;
  left: 0;
  background-color: currentColor;
  transition: width 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.nav-links a:hover::after {
  width: 100%;
}

/* Right Section: Icons */
.cust-header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 28px;
  flex: 1;
}
.icon-link {
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: opacity 0.3s ease, transform 0.3s ease;
}
.icon-link:hover {
  opacity: 0.6;
  transform: scale(1.05);
}
.cart-link {
  position: relative;
}
.cart-count {
  position: absolute;
  top: -8px;
  right: -10px;
  background-color: currentColor;
  color: var(--bg_color, #fff);
  font-size: 10px;
  font-weight: 700;
  border-radius: 50%;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}
/* Force contrasting color for cart text */
.cart-count {
  filter: invert(1);
}

/* Mobile Drawer Menu */
.mobile-drawer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
  z-index: 1999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s ease, visibility 0.4s ease;
  backdrop-filter: blur(4px);
}
body.menu-open .mobile-drawer-overlay {
  opacity: 1;
  visibility: visible;
}

.mobile-drawer {
  position: fixed;
  top: 0;
  left: -100%;
  width: 380px;
  max-width: 85%;
  height: 100vh;
  z-index: 2000;
  transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 5px 0 30px rgba(0,0,0,0.15);
  padding: 40px 40px;
  display: flex;
  flex-direction: column;
}
body.menu-open .mobile-drawer {
  left: 0;
}
body.menu-open {
  overflow: hidden;
}

.drawer-header {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 50px;
}
.drawer-close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
  transition: transform 0.3s ease;
}
.drawer-close:hover {
  transform: rotate(90deg);
}
.drawer-menu {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.drawer-menu a {
  text-decoration: none;
  color: inherit;
  font-size: 16px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  display: inline-block;
  transition: transform 0.3s ease;
}
.drawer-menu a:hover {
  transform: translateX(10px);
}

/* Responsive */
@media screen and (max-width: 990px) {
  .desktop-only {
    display: none;
  }
  .cust-header-main {
    padding: 0 20px;
  }
}
@media screen and (max-width: 768px) {
  .cust-menu-text {
    display: none;
  }
  .cust-header-main {
    height: 65px;
  }
  .cust-header-left {
    gap: 15px;
  }
  .cust-header-right {
    gap: 20px;
  }
  .mobile-drawer {
    padding: 30px 25px;
  }
}
</style>
