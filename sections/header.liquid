{% schema %}
{
  "name": "Island Header (Scrolled)",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Main Logo (Initial State)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 180,
      "unit": "px",
      "label": "Main logo width"
    },
    {
      "type": "image_picker",
      "id": "sticky_logo",
      "label": "Sticky Logo/Image (Scrolled State)"
    },
    {
      "type": "text",
      "id": "sticky_text",
      "label": "Sticky Text (if no sticky image)",
      "default": "• YOU Know where to GET IT •"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu (Pills)"
    },
    {
      "type": "text",
      "id": "highlight_link",
      "label": "Highlight Link Title (adds red dot)",
      "default": "Trending"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "pill_bg_color",
      "label": "Pill Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Pill Text Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "sticky_text_color",
      "label": "Sticky Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "default": true,
      "label": "Show Announcement text"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "10% OFF Automatically Applied on Orders ₹2,599+"
    }
  ]
}
{% endschema %}

<style>
:root {
  --pill-bg: {{ section.settings.pill_bg_color }};
  --pill-text: {{ section.settings.pill_text_color }};
  --sticky-text-color: {{ section.settings.sticky_text_color }};
}

#shopify-section-{{ section.id }} {
  position: relative;
  z-index: 1000;
}

.announcement-bar {
  background-color: #000;
  color: #fff;
  text-align: center;
  padding: 8px 15px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

/* Header Container */
.site-header {
  position: absolute; /* Overlays the hero section */
  top: {% if section.settings.show_announcement %}30px{% else %}0{% endif %};
  left: 0;
  width: 100%;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.site-header.scrolled {
  position: fixed;
  top: 15px; /* Floating island effect when scrolled */
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
  max-width: 1800px;
  margin: 0 auto;
  transition: all 0.4s ease;
}

.site-header.scrolled .header-inner {
  padding: 10px 40px;
}

/* Navigation Pills (Left) */
.header-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.header-left {
  position: relative;
  display: flex;
  align-items: center;
}

.pill-nav {
  display: flex;
  gap: 10px;
  list-style: none;
  padding: 0;
  margin: 0;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  opacity: 1;
  transform: translateX(0);
}

.site-header.scrolled .pill-nav {
  opacity: 0;
  transform: translateX(-20px);
  pointer-events: none;
  position: absolute;
}

.pill-link {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--pill-bg);
  color: var(--pill-text);
  padding: 8px 18px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
  letter-spacing: 0.3px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.pill-link:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.12);
}

.red-dot {
  width: 8px;
  height: 8px;
  background-color: #ff0000;
  border-radius: 50%;
  display: inline-block;
  margin-left: 2px;
}

/* Center Logos */
.header-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  height: 60px;
}

.main-logo, .sticky-logo {
  position: absolute;
  transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}

.main-logo {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

.sticky-logo {
  opacity: 0;
  visibility: hidden;
  transform: translateY(15px) scale(0.95);
}

.sticky-text {
  font-family: 'Comic Sans MS', 'Caveat', cursive, sans-serif;
  font-size: 24px;
  font-weight: bold;
  color: var(--sticky-text-color);
  letter-spacing: 2px;
  text-shadow: 0 2px 10px rgba(0,0,0,0.15);
  white-space: nowrap;
}

/* Scroll state for logos */
.site-header.scrolled .main-logo {
  opacity: 0;
  visibility: hidden;
  transform: translateY(-15px) scale(0.95);
}

.site-header.scrolled .sticky-logo {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}

/* Icons (Right) */
.header-right {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
}

.icon-circle {
  width: 42px;
  height: 42px;
  background: var(--pill-bg);
  color: var(--pill-text);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.icon-circle:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.12);
}

.icon-brand {
  border: 2px solid transparent;
  background-image: linear-gradient(var(--pill-bg), var(--pill-bg)), linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
  background-origin: border-box;
  background-clip: content-box, border-box;
}
.icon-brand-text {
  font-weight: bold;
  font-size: 16px;
  background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.cart-pill {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--pill-bg);
  color: var(--pill-text);
  padding: 8px 18px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.cart-pill:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.12);
}

.cart-divider {
  color: #d0d0d0;
  font-weight: 300;
  font-size: 14px;
}

.cart-count {
  font-weight: 600;
}

/* Hamburger & Drawer */
.hamburger-btn {
  display: flex;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  position: absolute;
  transform: translateX(-20px);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  pointer-events: none;
}

.site-header.scrolled .hamburger-btn {
  opacity: 1;
  visibility: visible;
  position: relative;
  transform: translateX(0);
  pointer-events: auto;
}

.hamburger-icon {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.hamburger-icon span {
  width: 18px;
  height: 2px;
  background-color: currentColor;
  display: block;
}

@media screen and (max-width: 1024px) {
  .pill-nav, .site-header.scrolled .pill-nav {
    display: none !important;
  }
  .hamburger-btn, .site-header.scrolled .hamburger-btn {
    opacity: 1 !important;
    visibility: visible !important;
    position: relative !important;
    transform: none !important;
    pointer-events: auto !important;
  }
  .header-inner {
    padding: 15px 20px;
  }
  .sticky-text {
    font-size: 18px;
  }
}

/* Mobile Drawer Overlay */
.mobile-drawer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
  z-index: 1999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s ease, visibility 0.4s ease;
  backdrop-filter: blur(4px);
}
body.menu-open .mobile-drawer-overlay {
  opacity: 1;
  visibility: visible;
}

.mobile-drawer {
  position: fixed;
  top: 0;
  left: -100%;
  width: 380px;
  max-width: 85%;
  height: 100vh;
  z-index: 2000;
  background-color: var(--pill-bg);
  color: var(--pill-text);
  transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 5px 0 30px rgba(0,0,0,0.15);
  padding: 40px;
  display: flex;
  flex-direction: column;
}
body.menu-open .mobile-drawer {
  left: 0;
}
body.menu-open {
  overflow: hidden;
}

.drawer-header {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 50px;
}
.drawer-close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 5px;
  color: inherit;
}
.drawer-menu {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.drawer-menu a {
  text-decoration: none;
  color: inherit;
  font-size: 18px;
  font-weight: 500;
}
</style>

{% if section.settings.show_announcement %}
<div class="announcement-bar" id="announcement-bar">
  {{ section.settings.announcement_text }}
</div>
{% endif %}

<header id="site-header" class="site-header">
  <div class="header-inner">
    
    <!-- Left: Navigation Pills & Hamburger -->
    <nav class="header-left">
      <ul class="pill-nav">
        {% for link in section.settings.menu.links %}
          <li>
            <a href="{{ link.url }}" class="pill-link">
              {{ link.title }}
              {% if link.title == section.settings.highlight_link %}
                <span class="red-dot"></span>
              {% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
      
      <!-- Hamburger Pill (Morphs on scroll / Mobile) -->
      <div class="pill-link hamburger-btn" onclick="document.body.classList.toggle('menu-open')">
        <div class="hamburger-icon">
          <span></span><span></span><span></span>
        </div>
        Menu
      </div>
    </nav>
    
    <!-- Center: Morphing Logos -->
    <div class="header-center">
      <a href="{{ routes.root_url }}" class="main-logo">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: width: section.settings.logo_width }}
        {% else %}
          <h2 style="margin: 0; font-weight: 800; font-size: 28px; color: #fff;">{{ shop.name }}</h2>
        {% endif %}
      </a>
      
      <a href="{{ routes.root_url }}" class="sticky-logo">
        {% if section.settings.sticky_logo != blank %}
          {{ section.settings.sticky_logo | image_url: width: 300 | image_tag: class: 'sticky-logo-img' }}
        {% else %}
          <span class="sticky-text">{{ section.settings.sticky_text }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Right: Icons & Cart -->
    <div class="header-right">
      <a href="#" class="icon-circle icon-brand">
         <span class="icon-brand-text">नी</span>
      </a>
      
      <a href="#" class="icon-circle desktop-only">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
      </a>

      <a href="{{ routes.search_url }}" class="icon-circle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="icon-circle desktop-only">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="cart-pill">
        <span>Cart</span>
        <span class="cart-divider">|</span>
        <span class="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
    
  </div>
</header>

<!-- Mobile Drawer -->
<div class="mobile-drawer-overlay" onclick="document.body.classList.remove('menu-open')"></div>
<div class="mobile-drawer">
  <div class="drawer-header">
    <button class="drawer-close" onclick="document.body.classList.remove('menu-open')">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <ul class="drawer-menu">
    {% for link in section.settings.menu.links %}
      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
    {% endfor %}
  </ul>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const header = document.getElementById('site-header');
  
  function handleScroll() {
    if (window.scrollY > 50) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  }

  window.addEventListener('scroll', handleScroll);
  // Trigger on load in case the page is already scrolled
  handleScroll();
});
</script>
