{% schema %}
{
  "name": "Nisho Countdown",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Leaving soon"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get 30% Off on our seasonal sale!"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target Date & Time",
      "info": "Format: YYYY-MM-DDTHH:MM:SS (e.g. 2026-12-31T23:59:59)",
      "default": "2026-12-31T23:59:59"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Nisho Countdown"
    }
  ]
}
{% endschema %}

<style>
  .ncd-section-{{ section.id }} {
    padding: 80px 40px;
    background: #ffffff;
    text-align: {{ section.settings.text_alignment }};
  }

  @media screen and (max-width: 768px) {
    .ncd-section-{{ section.id }} {
      padding: 60px 20px;
    }
  }

  .ncd-heading {
    font-size: 36px;
    font-weight: 500;
    color: #121212;
    margin: 0 0 10px 0;
    font-family: 'SF Pro Display', -apple-system, sans-serif;
  }

  .ncd-subheading {
    font-size: 18px;
    font-weight: 600;
    color: #d32f2f; /* Promotional Red */
    margin: 0 0 40px 0;
  }

  /* Countdown Flexbox */
  .ncd-timer {
    display: inline-flex;
    gap: 30px;
    justify-content: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
  }

  .ncd-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 70px;
  }

  .ncd-number {
    font-size: 48px;
    font-weight: 700;
    color: #121212;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .ncd-label {
    font-size: 13px;
    font-weight: 500;
    color: #777;
    margin-top: 5px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  @media screen and (max-width: 768px) {
    .ncd-heading { font-size: 28px; }
    .ncd-subheading { font-size: 16px; margin-bottom: 30px; }
    .ncd-timer { gap: 20px; }
    .ncd-number { font-size: 36px; }
    .ncd-block { min-width: 50px; }
  }
</style>

<div class="ncd-section-{{ section.id }}">
  <h2 class="ncd-heading">{{ section.settings.heading }}</h2>
  <div class="ncd-subheading">{{ section.settings.subheading }}</div>

  <div class="ncd-timer" id="ncd-timer-{{ section.id }}" data-target="{{ section.settings.target_date }}">
    <div class="ncd-block">
      <span class="ncd-number" id="ncd-days-{{ section.id }}">00</span>
      <span class="ncd-label">Days</span>
    </div>
    <div class="ncd-block">
      <span class="ncd-number" id="ncd-hours-{{ section.id }}">00</span>
      <span class="ncd-label">Hours</span>
    </div>
    <div class="ncd-block">
      <span class="ncd-number" id="ncd-mins-{{ section.id }}">00</span>
      <span class="ncd-label">Minutes</span>
    </div>
    <div class="ncd-block">
      <span class="ncd-number" id="ncd-secs-{{ section.id }}">00</span>
      <span class="ncd-label">Seconds</span>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const timerEl = document.getElementById('ncd-timer-{{ section.id }}');
    if (!timerEl) return;

    const targetStr = timerEl.getAttribute('data-target');
    if (!targetStr) return;

    const targetDate = new Date(targetStr).getTime();
    if (isNaN(targetDate)) {
      console.error('Invalid countdown target date:', targetStr);
      return;
    }

    const daysEl = document.getElementById('ncd-days-{{ section.id }}');
    const hoursEl = document.getElementById('ncd-hours-{{ section.id }}');
    const minsEl = document.getElementById('ncd-mins-{{ section.id }}');
    const secsEl = document.getElementById('ncd-secs-{{ section.id }}');

    function updateTimer() {
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance <= 0) {
        clearInterval(interval);
        daysEl.innerText = "00";
        hoursEl.innerText = "00";
        minsEl.innerText = "00";
        secsEl.innerText = "00";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      daysEl.innerText = days < 10 ? '0' + days : days;
      hoursEl.innerText = hours < 10 ? '0' + hours : hours;
      minsEl.innerText = minutes < 10 ? '0' + minutes : minutes;
      secsEl.innerText = seconds < 10 ? '0' + seconds : seconds;
    }

    updateTimer(); // Initial call
    const interval = setInterval(updateTimer, 1000);
  });
</script>
