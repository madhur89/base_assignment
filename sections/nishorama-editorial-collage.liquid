{% schema %}
{
  "name": "Nisho Editorial Collage",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Optional Heading"
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "image",
      "name": "Image Panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nisho Editorial Collage",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .nec-section-{{ section.id }} {
    padding: 60px 40px;
    background: #ffffff;
  }

  @media screen and (max-width: 768px) {
    .nec-section-{{ section.id }} {
      padding: 40px 20px;
    }
  }

  .nec-header {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .nec-heading {
    font-size: 28px;
    font-weight: 500;
    color: #121212;
    margin: 0;
    font-family: 'SF Pro Display', -apple-system, sans-serif;
  }

  /* Asymmetric Editorial Grid */
  .nec-grid {
    display: grid;
    /* 3 columns: Medium Left, Huge Center, Small Right */
    grid-template-columns: 1.2fr 2fr 1fr;
    grid-auto-rows: 250px;
    gap: 15px;
  }

  .nec-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #f4f4f4;
    transition: transform 0.4s ease;
  }

  .nec-item:hover {
    transform: scale(0.98);
  }

  .nec-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .nec-item:hover .nec-image {
    transform: scale(1.05);
  }

  /* Specific positions based on the 5-block limit to create the collage */
  /* Central Dominant Image (Block 1) */
  .nec-item:nth-child(1) {
    grid-column: 2;
    grid-row: 1 / span 3; /* Spans 3 rows (750px + gaps) */
  }

  /* Left Top (Block 2) */
  .nec-item:nth-child(2) {
    grid-column: 1;
    grid-row: 1 / span 2; /* Taller */
  }

  /* Left Bottom (Block 3) */
  .nec-item:nth-child(3) {
    grid-column: 1;
    grid-row: 3 / span 1; /* Shorter */
  }

  /* Right Top (Block 4) */
  .nec-item:nth-child(4) {
    grid-column: 3;
    grid-row: 1 / span 1.5;
  }

  /* Right Bottom (Block 5) */
  .nec-item:nth-child(5) {
    grid-column: 3;
    grid-row: 2.5 / span 1.5;
  }

  /* Tablet Adjustments */
  @media screen and (max-width: 1024px) {
    .nec-grid {
      grid-template-columns: 1fr 1.5fr;
      grid-auto-rows: 200px;
    }
    .nec-item:nth-child(1) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .nec-item:nth-child(2) {
      grid-column: 1;
      grid-row: 1 / span 1;
    }
    .nec-item:nth-child(3) {
      grid-column: 1;
      grid-row: 2 / span 1;
    }
    .nec-item:nth-child(4) {
      grid-column: 1 / span 2;
      grid-row: 3 / span 1;
    }
    .nec-item:nth-child(5) {
      display: none; /* Simplify on tablet */
    }
  }

  /* Mobile Adjustments - Stacked Asymmetric */
  @media screen and (max-width: 768px) {
    .nec-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .nec-item {
      width: 100%;
    }
    
    .nec-item:nth-child(1) { height: 450px; }
    .nec-item:nth-child(2) { height: 300px; }
    .nec-item:nth-child(3) { height: 250px; }
    .nec-item:nth-child(4) { height: 350px; display: block; }
    .nec-item:nth-child(5) { height: 200px; display: block; }
  }
</style>

<div class="nec-section-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="nec-header">
      <h2 class="nec-heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="nec-grid">
    {%- for block in section.blocks -%}
      <div class="nec-item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" aria-label="Collage Image" style="display:block; width:100%; height:100%;">
        {%- endif -%}

        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'nec-image', loading: 'lazy' }}
        {%- else -%}
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#e8e8e8;">
            {{ 'image' | placeholder_svg_tag: 'nec-image' }}
          </div>
        {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
