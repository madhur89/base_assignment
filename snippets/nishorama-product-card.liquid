{%- comment -%}
  Accepts:
  - product: {Object} Product Liquid object
  - show_badge: {Boolean} Show a custom badge if tagged
  - show_secondary_image: {Boolean} Show second image on hover
  - show_quick_add: {Boolean} Show + Add button
  - emphasize_sale: {Boolean} Used in "Leaving Soon" to heavily emphasize red text and discount %
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign price = current_variant.price
  assign compare_at_price = current_variant.compare_at_price
  assign available = current_variant.available

  assign on_sale = false
  assign discount_percentage = 0
  if compare_at_price > price
    assign on_sale = true
    assign discount_percentage = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
  endif

  assign has_secondary_image = false
  if show_secondary_image and product.images[1] != blank
    assign has_secondary_image = true
  endif
-%}

<div class="nisho-product-card">
  <div class="npc-image-wrapper">
    <a href="{{ product.url }}" class="npc-image-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 600 | image_tag: class: 'npc-primary-image', loading: 'lazy' }}
        {%- if has_secondary_image -%}
          {{ product.images[1] | image_url: width: 600 | image_tag: class: 'npc-secondary-image', loading: 'lazy' }}
        {%- endif -%}
      {%- else -%}
        <div class="npc-placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}
    </a>

    {%- if show_badge -%}
      <div class="npc-badges">
        {%- if on_sale and emphasize_sale -%}
          <span class="npc-badge sale-badge">{{ discount_percentage }}% OFF</span>
        {%- elsif on_sale -%}
          <span class="npc-badge sale-badge">Sale</span>
        {%- endif -%}
        {%- unless available -%}
          <span class="npc-badge sold-out-badge">Sold out</span>
        {%- endunless -%}
      </div>
    {%- endif -%}

    {%- if show_quick_add -%}
      <div class="npc-quick-add">
        {%- if available -%}
          <button class="npc-add-btn" 
                  type="button" 
                  aria-label="Add to cart"
                  data-variant-id="{{ current_variant.id }}"
                  onclick="nishoramaAddToCart(this, event)">
            + Add
          </button>
        {%- else -%}
          <button class="npc-add-btn disabled" disabled>Sold out</button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="npc-info">
    <a href="{{ product.url }}" class="npc-title">{{ product.title }}</a>
    
    <div class="npc-price-row {% if emphasize_sale and on_sale %}npc-price-emphasized{% endif %}">
      {%- if on_sale -%}
        <span class="npc-compare-price">{{ compare_at_price | money }}</span>
        <span class="npc-regular-price sale-color">{{ price | money }}</span>
      {%- else -%}
        <span class="npc-regular-price">{{ price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .nisho-product-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    font-family: 'SF Pro Display', -apple-system, sans-serif;
  }
  
  .npc-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 12px;
    overflow: hidden;
    background: #f4f4f4;
  }

  .npc-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .npc-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, opacity 0.4s ease;
  }

  .npc-secondary-image {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .npc-image-wrapper:hover .npc-secondary-image {
    opacity: 1;
  }
  .npc-image-wrapper:hover .npc-primary-image {
    opacity: 0;
  }

  .npc-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    pointer-events: none;
  }

  .npc-badge {
    background: #ffffff;
    color: #121212;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }

  .sale-badge {
    color: #d32f2f;
  }

  .npc-quick-add {
    position: absolute;
    bottom: 15px;
    right: 15px;
    z-index: 2;
  }

  .npc-add-btn {
    background: #ffffff;
    color: #121212;
    border: none;
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .npc-add-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.15);
  }
  
  .npc-add-btn.disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }
  .npc-add-btn.loading {
    color: transparent;
    position: relative;
    pointer-events: none;
  }
  .npc-add-btn.loading::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    margin-left: -7px;
    border: 2px solid rgba(0,0,0,0.2);
    border-top-color: #121212;
    border-radius: 50%;
    animation: npcSpin 0.6s linear infinite;
  }

  @keyframes npcSpin {
    to { transform: rotate(360deg); }
  }

  .npc-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0 5px;
  }

  .npc-title {
    font-size: 14px;
    font-weight: 500;
    color: #121212;
    text-decoration: none;
    max-width: 60%;
    line-height: 1.3;
  }

  .npc-price-row {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 14px;
    font-weight: 600;
  }

  .npc-compare-price {
    font-size: 12px;
    color: #777;
    text-decoration: line-through;
    margin-bottom: 2px;
  }

  .npc-price-emphasized .sale-color {
    color: #d32f2f;
  }
</style>

<script>
  if (typeof nishoramaAddToCart !== 'function') {
    function nishoramaAddToCart(btn, event) {
      event.preventDefault();
      event.stopPropagation();
      
      const variantId = btn.getAttribute('data-variant-id');
      if (!variantId) return;

      btn.classList.add('loading');

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{ id: parseInt(variantId), quantity: 1 }]
        })
      })
      .then(response => response.json())
      .then(data => {
        btn.classList.remove('loading');
        
        // Let's trigger a cart update event so the theme's native cart drawer can open
        document.dispatchEvent(new CustomEvent('cart:updated'));
        
        // Also fire the standard shopify event for some themes
        document.dispatchEvent(new Event('cart:refresh'));
      })
      .catch((error) => {
        console.error('Error:', error);
        btn.classList.remove('loading');
        btn.innerText = 'Error';
        setTimeout(() => btn.innerText = '+ Add', 2000);
      });
    }
  }
</script>
